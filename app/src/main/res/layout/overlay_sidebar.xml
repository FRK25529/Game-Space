<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/sidebar_bg"
    android:elevation="12dp"
    android:padding="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="8dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="⚡ FAROUK SPACE"
            android:textColor="#ff2244" android:textSize="12sp" android:textStyle="bold"
            android:fontFamily="monospace"/>
        <TextView android:id="@+id/sb_btn_close"
            android:layout_width="28dp" android:layout_height="28dp"
            android:text="✕" android:textColor="#7a8099" android:textSize="14sp"
            android:gravity="center" android:background="@drawable/btn_bg_dark"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/metric_bg" android:padding="8dp"
        android:layout_marginBottom="6dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="🎮 FPS"
            android:textColor="#7a8099" android:textSize="11sp"/>
        <TextView android:id="@+id/sb_fps" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="--"
            android:textColor="#00e676" android:textSize="18sp" android:textStyle="bold"
            android:fontFamily="monospace"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/metric_bg"
        android:padding="8dp" android:layout_marginBottom="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="🔥 CPU"
                android:textColor="#7a8099" android:textSize="11sp"/>
            <TextView android:id="@+id/sb_cpu" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textColor="#ffd600" android:textSize="16sp" android:textStyle="bold"
                android:fontFamily="monospace"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/pb_cpu"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="4dp"
            android:progressTint="#ffd600" android:progressBackgroundTint="#1a1a0a"
            android:max="100" android:progress="0" android:layout_marginTop="4dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/metric_bg"
        android:padding="8dp" android:layout_marginBottom="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="💾 RAM"
                android:textColor="#7a8099" android:textSize="11sp"/>
            <TextView android:id="@+id/sb_ram" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textColor="#2979ff" android:textSize="16sp" android:textStyle="bold"
                android:fontFamily="monospace"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/pb_ram"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="4dp"
            android:progressTint="#2979ff" android:progressBackgroundTint="#0a0a1a"
            android:max="100" android:progress="0" android:layout_marginTop="4dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/metric_bg"
        android:padding="8dp" android:layout_marginBottom="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="🔋 BAT"
                android:textColor="#7a8099" android:textSize="11sp"/>
            <TextView android:id="@+id/sb_bat" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textColor="#00e676" android:textSize="16sp" android:textStyle="bold"
                android:fontFamily="monospace"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/pb_bat"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="4dp"
            android:progressTint="#00e676" android:progressBackgroundTint="#0a1a0a"
            android:max="100" android:progress="0" android:layout_marginTop="4dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/metric_bg"
        android:padding="8dp" android:layout_marginBottom="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="🌡️ TEMP"
                android:textColor="#7a8099" android:textSize="11sp"/>
            <TextView android:id="@+id/sb_temp" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textColor="#ff5500" android:textSize="16sp" android:textStyle="bold"
                android:fontFamily="monospace"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/pb_temp"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="4dp"
            android:progressTint="#ff5500" android:progressBackgroundTint="#1a0a00"
            android:max="100" android:progress="0" android:layout_marginTop="4dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/metric_bg" android:padding="8dp"
        android:layout_marginBottom="10dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="📶 NET"
            android:textColor="#7a8099" android:textSize="11sp"/>
        <TextView android:id="@+id/sb_net" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="--"
            android:textColor="#2979ff" android:textSize="13sp" android:textStyle="bold"
            android:fontFamily="monospace"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/sb_btn_boost"
            android:layout_width="0dp" android:layout_height="36dp"
            android:layout_weight="1" android:text="⚡"
            android:textSize="16sp" android:gravity="center"
            android:background="@drawable/btn_bg_red"
            android:layout_marginEnd="4dp"/>
        <TextView android:id="@+id/sb_btn_kill"
            android:layout_width="0dp" android:layout_height="36dp"
            android:layout_weight="1" android:text="💀"
            android:textSize="16sp" android:gravity="center"
            android:background="@drawable/btn_bg_dark"/>
    </LinearLayout>

</LinearLayout>
